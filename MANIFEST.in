include autospan.yaml autospan.fake.yaml autospan.raytac.yaml autospan.sniffer-setup.yaml CONTRIBUTING.md
include autospan-workspace.yaml SECURITY.md
recursive-include docs *.md
recursive-include tests *.py *.toml
